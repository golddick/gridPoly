# # Point this at your Supabase project's connection string (Project Settings > Database > Connection string > URI).
# # Use the "Transaction" pooler string for serverless/Next.js, and a direct connection for the standalone room server if needed.
# DATABASE_URL="postgresql://user:password@localhost:5432/gride"

# # Supabase Auth (Project Settings > API)
# # Enable Anonymous Sign-ins under Authentication > Providers before running the app.
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# # Redis (ephemeral room/turn state, presence)
# REDIS_URL="redis://localhost:6379"

# # Room / WebSocket server
# WS_PORT=4000
# NEXT_PUBLIC_WS_URL="http://localhost:4000"
# CLIENT_ORIGIN="http://localhost:3000"

# # Auth
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="replace-with-a-random-secret"

# db_pass=O1Fqg5mLHCff0aqU

# # Payments (future phase — not active in Phase 1, leave unset)
# # STRIPE_SECRET_KEY=
# # PAYSTACK_SECRET_KEY=
















# Postgres — Supabase project's Database connection string.
# Project Settings > Database > Connection string.
#
# No IPv6 available? Use the SESSION POOLER string (not "Direct connection" —
# that host is IPv6-only unless you've bought the IPv4 add-on). Session
# pooler is IPv4-compatible and supports migrations (DDL/prepared
# statements), so one URL works for both `prisma migrate` and the app's
# runtime queries as long as you're running this as a normal long-lived
# Node process (not serverless functions).
#   postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Only if you later deploy the Next.js app itself to serverless functions
# (e.g. Vercel) should you split this: DATABASE_URL -> Transaction pooler
# (port 6543, add `?pgbouncer=true&connection_limit=1`), and add a
# DIRECT_URL env var -> Session pooler, then add `directUrl = env("DIRECT_URL")`
# to the datasource block in prisma/schema.prisma for migrations to keep working.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres"

# Supabase Auth (Project Settings > API) — this is a separate hosted service,
# unrelated to DATABASE_URL. Anonymous sign-in, email/password, etc. all go
# through this URL/key directly, no Postgres connection involved.
# Enable Anonymous Sign-ins under Authentication > Providers before running the app.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Redis (ephemeral room/turn state, presence) — optional. If unset or
# unreachable, the app logs one warning and keeps working; presence tracking
# just won't be available. Get a free one at upstash.com if you want it.
REDIS_URL="redis://localhost:6379"

# Next.js and the game server now run as ONE process on ONE port (see
# server.ts) — no separate WS_PORT/NEXT_PUBLIC_WS_URL needed for local dev.
# PORT defaults to 3000; only set it if you need a different port.
# PORT=3000
#
# CLIENT_ORIGIN defaults to http://localhost:$PORT, which is correct for
# local dev. Only set this explicitly in production, to your real domain
# (needed for Socket.IO's CORS check to accept the connection).
# CLIENT_ORIGIN="https://your-domain.com"
#
# NEXT_PUBLIC_WS_URL is normally unset — the client connects to whatever
# origin served the page. Only set it if the game server is hosted at a
# genuinely different origin than the Next.js app (an unusual split setup).
# NEXT_PUBLIC_WS_URL="https://your-domain.com"

# Payments (future phase — not active in Phase 1, leave unset)
# STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=